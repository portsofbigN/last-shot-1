// Launcher.exe resources: version information and the application manifest (tools/build_launcher.py)
// numbers instead of winver.h: VS_VERSION_INFO 1, VOS_NT_WINDOWS32 0x40004, VFT_APP 1

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION 0,0,3,0
PRODUCTVERSION 0,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Splatoon Raiders Recomp project"
            VALUE "FileDescription", "Splatoon Raiders Recomp Launcher (settings and shader preparation)"
            VALUE "FileVersion", "0.0.3.0"
            VALUE "InternalName", "Launcher"
            VALUE "LegalCopyright", "GPL-3.0-or-later"
            VALUE "OriginalFilename", "Launcher.exe"
            VALUE "ProductName", "Splatoon Raiders Recomp"
            VALUE "ProductVersion", "0.0.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
