#version 450
// SMAA pass 2: blending weights from the edges, the area and search tables.
#extension GL_GOOGLE_include_directive : require
#include "smaa_common.glsl"
layout(binding = 0) uniform sampler2D edgesTex;    // linear
layout(binding = 2) uniform sampler2D areaTex;     // linear
layout(binding = 3) uniform sampler2D searchTex;   // nearest
layout(binding = 1, rgba8) uniform writeonly image2D weights;
void main() {
    ivec2 p;
    vec2 uv;
    if (!smaa_pixel(p, uv)) return;
    vec2 pix;
    vec4 off[3];
    SMAABlendingWeightCalculationVS(uv, pix, off);
    imageStore(weights, p, SMAABlendingWeightCalculationPS(uv, pix, off, edgesTex, areaTex, searchTex, vec4(0.0)));
}
