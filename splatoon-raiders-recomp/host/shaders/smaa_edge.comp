#version 450
// SMAA pass 1: luma edges of the frame (sRGB-encoded, as SMAA wants for luma) into an RG8 image.
#extension GL_GOOGLE_include_directive : require
#include "smaa_common.glsl"
layout(binding = 0) uniform sampler2D colorTex;
layout(binding = 1, rg8) uniform writeonly image2D edges;
void main() {
    ivec2 p;
    vec2 uv;
    if (!smaa_pixel(p, uv)) return;
    vec4 off[3];
    SMAAEdgeDetectionVS(uv, off);
    imageStore(edges, p, vec4(SMAALumaEdgeDetectionPS(uv, off, colorTex), 0.0, 0.0));
}
